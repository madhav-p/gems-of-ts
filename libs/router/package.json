{
  "name": "@gems-of-ts/router",
  "version": "0.0.0",
  "description": "Schema-typed router with separate server and client entrypoints.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@gems-of-ts/schema": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
